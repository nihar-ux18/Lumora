APP_NAME=Lumora API
APP_VERSION=0.1.0
APP_ENV=production
DEBUG=false

HOST=0.0.0.0
PORT=8000
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/lumora
REDIS_URL=redis://localhost:6379

JWT_SECRET_KEY=replace_with_secure_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_VERIFICATION_EXPIRE_HOURS=24

BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=noreply@lumora.app
BREVO_SENDER_NAME=Lumora

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=
GEMINI_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=lumora-resources

CORS_ORIGINS=http://localhost:3000